# ============================================
# 生产环境配置
# ============================================
# 复制为 .env 并修改后使用: cp .env.production .env

# Server
SERVER_PORT=8080
SERVER_MODE=release

# Database（容器内通过 host.docker.internal 连接宿主机 PostgreSQL）
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=poem
DB_PASSWORD=请修改为强密码
DB_NAME=poem
DB_SSLMODE=disable

# JWT（必须修改为强随机值！）
JWT_SECRET=请替换为至少32字符的随机字符串
JWT_EXPIRE_HOUR=72

# WebAuthn / Passkey
RP_DISPLAY_NAME=晓诗
RP_ID=poem.simpledefine.fun
RP_ORIGIN=https://poem.simpledefine.fun

# Email（账户恢复，可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@xiaoshi.app
